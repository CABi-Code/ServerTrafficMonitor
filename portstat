#!/usr/bin/env bash
# portstat — подключения, уникальные IP, трафик и скорость по портам,
# с разбивкой по процессу (NAME) и состоянию TCP (STATUS).
# Источники: conntrack (байты TCP+UDP) + ss (точное состояние и имя процесса).
STATE=/tmp/portstat.state
HIST=/tmp/portstat.history
HISTMAX=60

# --- публичные IP сервера ---
SRV=$(ip -o -4 addr show scope global | awk '{print $4}' | cut -d/ -f1 \
      | grep -vE '^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.|169\.254\.)')
SRVRE=$(printf '%s\n' "$SRV" | sed 's/\./\\./g' | paste -sd '|')

# --- слушающие порты ---
LPORTS=$(ss -lntuH 2>/dev/null | awk '{print $5}' | grep -vE '^(127\.|\[::1\])' \
         | sed 's/.*://' | sort -un | paste -sd '|')

# приватные / служебные адреса контрагента, которые НЕ считаем «клиентом»
PRIV='^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.|169\.254\.|0\.0\.0\.0$)'

# --- оверлей из ss: состояние + имя процесса на соединение, имя на локальный сокет ---
SSF=$(mktemp)
{ ss -tanp 2>/dev/null; ss -uanp 2>/dev/null; } | awk '
  function canon(a,b){ return (a<b) ? a "|" b : b "|" a }
  $1=="State" || $1=="Netid" { next }
  NF>=5 {
    st=$1; local=$4; peer=$5; name="-"
    for(i=6;i<=NF;i++) if($i ~ /^users:/){ split($i,q,"\""); if(q[2]!="") name=q[2]; break }
    if(name!="-") nm[local]=name
    if(st=="LISTEN" || peer ~ /(\*|0\.0\.0\.0:|\[::\]:)/) next
    key=canon(local,peer)
    cstate[key]=st
    if(name!="-") cname[key]=name
  }
  END{
    for(k in cstate) print "C\t" k "\t" cstate[k] "\t" (cname[k]?cname[k]:"-")
    for(l in nm)     print "N\t" l "\t" nm[l]
  }
' > "$SSF"

now=$(date +%s.%N)

# --- conntrack: один поток = одна запись ---
# поля: dir port name state clientip up_bytes down_bytes flowkey
FLOWS=$(conntrack -L 2>/dev/null | awk \
  -v lp="^($LPORTS)$" -v srv="^($SRVRE)$" -v priv="$PRIV" -v ssf="$SSF" '
  function canon(a,b){ return (a<b) ? a "|" b : b "|" a }
  function mapstate(s){
    if(s=="ESTABLISHED") return "ESTAB"
    if(s=="TIME_WAIT")   return "TIME-WAIT"
    if(s=="FIN_WAIT")    return "FIN-WAIT"
    if(s=="CLOSE_WAIT")  return "CLOSE-WAIT"
    if(s=="SYN_SENT")    return "SYN-SENT"
    if(s=="SYN_RECV")    return "SYN-RECV"
    if(s=="LAST_ACK")    return "LAST-ACK"
    if(s=="CLOSE")       return "CLOSE"
    return s
  }
  BEGIN{
    while((getline line < ssf) > 0){
      n=split(line,f,"\t")
      if(f[1]=="C"){ ck[f[2]]=1; cstate[f[2]]=f[3]; cname[f[2]]=f[4] }
      else if(f[1]=="N"){ nmap[f[2]]=f[3] }
    }
  }
  {
    proto=$1; src=""; sport=""; dst=""; dport=""; nb=0; ub=0; db=0; ctst=""
    if(proto=="tcp" && $4 !~ /=/) ctst=$4
    else if(proto=="udp") ctst="UDP"
    for(i=1;i<=NF;i++){
      if(src==""   && $i ~ /^src=/)  { split($i,t,"="); src=t[2] }
      if(sport=="" && $i ~ /^sport=/){ split($i,t,"="); sport=t[2] }
      if(dst==""   && $i ~ /^dst=/)  { split($i,t,"="); dst=t[2] }
      if(dport=="" && $i ~ /^dport=/){ split($i,t,"="); dport=t[2] }
      if($i ~ /^bytes=/){ split($i,t,"="); nb++; if(nb==1) ub=t[2]+0; else if(nb==2) db=t[2]+0 }
    }
    if(src=="" || dst=="") next

    if(dport ~ lp && dst ~ srv){ dir="IN";  client=src; port=dport; lep=dst":"dport }
    else if(src ~ srv)        { dir="OUT"; client=dst; port=dport; lep=src":"sport }
    else next

    if(client ~ priv || client ~ srv) next

    e1=src":"sport; e2=dst":"dport
    key=canon(e1,e2)
    state = (key in ck && cstate[key]!="") ? cstate[key] : mapstate(ctst)
    name  = (key in ck && cname[key]!="-") ? cname[key] : (lep in nmap ? nmap[lep] : "-")
    gsub(/ /,"_",name)

    fk=proto":"src":"sport":"dst":"dport
    print dir, port, name, state, client, ub, db, fk
  }')

# --- сохранить состояние для расчёта скорости ---
{ echo "$now"; printf '%s\n' "$FLOWS" | awk 'NF>=8{print $8, $6, $7}'; } > "$STATE.new"

# --- агрегация по (dir,port,name,state) + скорость по дельтам ---
AGG=$(printf '%s\n' "$FLOWS" | awk -v statefile="$STATE" -v now="$now" '
  BEGIN{
    prevt=0
    if((getline l < statefile) > 0){
      prevt=l+0
      while((getline l < statefile) > 0){ split(l,f," "); pu[f[1]]=f[2]+0; pd[f[1]]=f[3]+0 }
    }
    dt=now-prevt; if(prevt==0 || dt<=0) dt=-1
  }
  NF>=8{
    dir=$1; port=$2; name=$3; state=$4; ip=$5; ub=$6+0; db=$7+0; fk=$8
    k=dir SUBSEP port SUBSEP name SUBSEP state
    conns[k]++; uba[k]+=ub; dba[k]+=db
    if(!((k SUBSEP ip) in seen)){ seen[k SUBSEP ip]=1; uq[k]++ }
    if(dt>0){
      if(fk in pu){ d=ub-pu[fk]; if(d>0) usp[k]+=d }
      if(fk in pd){ d=db-pd[fk]; if(d>0) dsp[k]+=d }
    }
  }
  END{
    for(k in conns){
      split(k,a,SUBSEP)
      printf "%s\t%s\t%s\t%s\t%d\t%d\t%d\t%d\t%.3f\t%.3f\n",
        a[1],a[2],a[3],a[4],conns[k],uq[k],uba[k],dba[k],
        (dt>0?usp[k]/dt:0),(dt>0?dsp[k]/dt:0)
    }
  }')

mv "$STATE.new" "$STATE"

# --- история ---
TOTC=$(printf '%s\n' "$AGG" | awk -F'\t' '{c+=$5} END{print c+0}')
TOTIP=$(printf '%s\n' "$FLOWS" | awk 'NF>=8{print $1"\t"$5}' | sort -u | grep -c . )
echo "$TOTC $TOTIP" >> "$HIST"
tail -n "$HISTMAX" "$HIST" > "$HIST.tmp" 2>/dev/null && mv "$HIST.tmp" "$HIST"

SEP="--------------------------------------------------------------------------------------------"

render() {
  local dir=$1
  printf '%s\n' "$AGG" | awk -F'\t' -v d="$dir" '$1==d' \
    | sort -t$'\t' -k9,9 -nr | awk -F'\t' -v sep="$SEP" '
    function ht(b,  i,u){split("B K M G T",u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}return sprintf("%.1f%s",b,u[i])}
    function hs(b,  i,u){split("B KiB MiB GiB TiB",u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}return sprintf("%.1f %s/s",b,u[i])}
    BEGIN{ BAR=24; printf "%-7s %-14s %-12s %-12s %-9s %s\n","PORT","NAME","STATUS","CONN / IP","TRAFFIC","SPEED (вверх↑ / вниз↓)"; print sep }
    {
      port[++n]=$2; nm[n]=$3; stt[n]=$4; ci[n]=$5" / "$6;
      tr[n]=$7+$8; us[n]=$9+0; ds[n]=$10+0; tot=us[n]+ds[n];
      sp[n]=tot; if(tot>mx)mx=tot; tc+=$5; tb+=tr[n]; tus+=us[n]; tds+=ds[n]
    }
    END{
      if(n==0){ print "  (нет активных соединений)"; print sep; exit }
      for(i=1;i<=n;i++){
        len=(mx>0)?int(sp[i]/mx*BAR+0.5):0
        if(sp[i]>0 && len<1) len=1
        bar=""; for(j=0;j<len;j++) bar=bar "█"
        spd=sprintf("↑%s  ↓%s", hs(us[i]), hs(ds[i]))
        printf "%-7s %-14s %-12s %-12s %-9s %-26s %s\n", port[i], nm[i], stt[i], ci[i], ht(tr[i]), spd, bar
      }
      print sep
      printf "%-7s %-14s %-12s %-12s %-9s ↑%s  ↓%s\n","ИТОГО","","","("tc" conn)", ht(tb), hs(tus), hs(tds)
    }
  '
}

spark() {
  local col=$1 label=$2
  awk -v col="$col" -v label="$label" '
    {v[NR]=$col+0; if(NR==1){mn=mx=$col+0} if($col+0>mx)mx=$col+0; if($col+0<mn)mn=$col+0}
    END{
      lv[0]=" ";lv[1]="░";lv[2]="▒";lv[3]="▓";lv[4]="█"; s=""
      for(i=1;i<=NR;i++){
        if(mx==mn) k=0; else k=int((v[i]-mn)/(mx-mn)*4+0.5)
        s = s ((v[i]==mn) ? " " : lv[k])
      }
      printf "%s |%s|\n", label, s
      printf "              | (мин %d / макс %d)\n", mn, mx
    }
  ' "$HIST"
}

echo "=== IP СЕРВЕРА ==="
printf '%s\n' "$SRV"
echo
echo "=== ВХОДЯЩИЕ (клиенты -> сервис) ==="
render IN
echo
echo "=== ИСХОДЯЩИЕ (сервер -> наружу) ==="
render OUT
echo
echo "=== ИСТОРИЯ (последние $HISTMAX замеров) ==="
echo
spark 1 "Соединения   "
echo
spark 2 "Уник. IP     "

rm -f "$SSF"
